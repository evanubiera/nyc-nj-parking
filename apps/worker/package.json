{
  "name": "@parking/worker",
  "private": true,
  "description": "Scheduled ingestion from admitted sources into PostGIS (ADR-0005). The only part of the system that calls upstream (ING-1).",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
