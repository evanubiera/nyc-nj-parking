    "test": "vitest run"
  },
  "dependencies": {
    "@parking/db": "workspace:*",
    "croner": "^10.0.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
